# SuperReconn Configuration
# ==========================
#
# Este archivo es un TEMPLATE de configuración.
# Copia este archivo a .env y ajusta los valores según tu entorno.
#
# IMPORTANTE: NUNCA commites .env a git (contiene credenciales).
# El archivo .gitignore ya excluye .env, pero por seguridad, verifica.
#
# USO:
#   cp .env.example .env
#   # Edita .env con tus valores
#   source .env
#   python3 SuperReconn.py example.com

# ============================================================================
# CONFIGURACIÓN DE HERRAMIENTAS Y PATHS
# ============================================================================

# Rutas adicionales donde buscar herramientas CLI (separadas por :)
# Útil si instalaste herramientas Go en directorios custom
# Ejemplo: RECON_TOOL_PATH=/custom/go/bin:/usr/local/bin
RECON_TOOL_PATH=

# ============================================================================
# CONFIGURACIÓN DE ESCANEO
# ============================================================================

# Límite de tasa para solicitudes (por segundo)
# Usa valores más altos si tu conexión es rápida (default: 100)
# Reduce si recibes rate limiting de objetivos
RECON_RATE_LIMIT=100

# Delay entre peticiones para eludir WAF (segundos)
# Aumenta si el objetivo tiene WAF agresivo (default: 1)
RECON_WAF_DELAY=1

# Proxy HTTP/HTTPS (opcional)
# Ejemplo: http://127.0.0.1:8080 o socks5://proxy.com:1080
RECON_PROXY=

# Número máximo de workers para paralelización (futuro)
# RECON_THREADS=10

# ============================================================================
# CONFIGURACIÓN DE SQL SERVER (OPCIONAL)
# ============================================================================
# Solo necesario si quieres persistencia en SQL Server.
# Usa: python3 persist_mssql.py <JSON_FILE> después de ejecutar SuperReconn
#
# Alternativamente, puedes configurar variables de entorno para que persist_mssql.py
# las use automáticamente.

# Dirección del servidor SQL Server
# Formato: hostname o hostname,puerto
MSSQL_SERVER=localhost

# Puerto SQL Server (default: 1433)
# MSSQL_PORT=1433

# Nombre de la base de datos
MSSQL_DATABASE=SuperReconn

# Driver ODBC para SQL Server
# Ubuntu 22.04+: ODBC Driver 18 for SQL Server
# Windows: SQL Server Native Client
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Tipo de autenticación: sql | windows
# - sql: SQL Server authentication (requiere USERNAME/PASSWORD)
# - windows: Windows/Kerberos authentication (requiere entorno configurado)
MSSQL_AUTH=sql

# Credenciales SQL Server (solo si MSSQL_AUTH=sql)
MSSQL_USERNAME=sa
MSSQL_PASSWORD=tu_password_aqui

# Encriptación de conexión: yes | no | strict
MSSQL_ENCRYPT=yes

# Confiar en certificado de servidor (self-signed)
# yes | no
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Timeout de conexión (segundos)
MSSQL_TIMEOUT=15

# ============================================================================
# CONFIGURACIÓN DE WORDLISTS Y RESOLVERS
# ============================================================================

# Ruta a wordlist de subdominios (default: ./wordlists/subdomains.txt)
# RECON_WORDLIST=./wordlists/subdomains.txt

# Ruta a archivo de resolvers DNS (default: ./resolvers.txt)
# RECON_RESOLVERS=./resolvers.txt

# ============================================================================
# LOGGING Y DEBUG
# ============================================================================

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
# Nota: Los logs a archivo siempre incluyen DEBUG
# LOG_LEVEL=INFO

# ============================================================================
# NOTAS FINALES
# ============================================================================
#
# 1. SuperReconn crea automáticamente:
#    - Un log de ejecución en: <output>/execution.log
#    - Un resumen en: <output>/discovery/summary.txt
#    - JSON consolidado en: <output>/structured/superreconn.json
#
# 2. Para SQL Server:
#    - Primero instala el driver: sudo apt install msodbcsql18
#    - Valida con: odbcinst -q -d | grep "ODBC Driver"
#    - Después de SuperReconn, ejecuta:
#      python3 persist_mssql.py ./resultados/target-2026-07-02/structured/superreconn.json
#
# 3. Para cambiar configuración sin editar .env:
#    - Puedes pasar flags a SuperReconn:
#      python3 SuperReconn.py target.com --rate-limit 200 --waf-delay 2
#    - O usar variables de entorno:
#      RECON_RATE_LIMIT=200 python3 SuperReconn.py target.com
